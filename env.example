# API Keys Configuration
# Copy this file to .env and fill in your API keys

# Meetup API Key
# Get your API key from: https://www.meetup.com/api/
# Note: Meetup requires OAuth 2.0 authentication
MEETUP_API_KEY=your_meetup_api_key_here

# Eventbrite OAuth Token
# Get your token from: https://www.eventbrite.com/platform/api
# Go to Account Settings -> Developer Links -> Create New Token
EVENTBRITE_TOKEN=your_eventbrite_oauth_token_here

# Ticketmaster API Key
# Get your API key from: https://developer.ticketmaster.com/
# Sign up for a free developer account
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Note: Luma and Cerebral Valley don't have public APIs
# They are accessed via web scraping (no API keys needed)

